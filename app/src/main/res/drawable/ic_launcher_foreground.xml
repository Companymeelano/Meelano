<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- hexagon shield -->
    <path
        android:pathData="M54,26 L74,37.5 L74,60.5 L54,72 L34,60.5 L34,37.5 Z"
        android:fillColor="#1400E5FF"
        android:strokeWidth="2.6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34" android:startY="26"
                android:endX="74" android:endY="72"
                android:type="linear">
                <item android:color="#FF00E5FF" android:offset="0" />
                <item android:color="#FF2979FF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- stylised M -->
    <path
        android:pathData="M43,61 L43,42 L54,52 L65,42 L65,61"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="43" android:startY="42"
                android:endX="65" android:endY="61"
                android:type="linear">
                <item android:color="#FF00E5FF" android:offset="0" />
                <item android:color="#FFB3ECFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
